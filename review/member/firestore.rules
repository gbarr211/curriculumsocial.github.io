rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function owner(uid){return request.auth != null && request.auth.uid == uid;}
  function text(v,max){return v is string && v.size() <= max;}
  function card(d){return {'displayName':d.displayName,'area':d.area,'languages':d.languages,'philosophies':d.philosophies,'interests':d.interests,'about':d.about,'photo':d.photo,'updatedAt':d.updatedAt};}
  function valid(d){return d.keys().hasAll(['displayName','area','languages','philosophies','interests','about','photo','contribution','availability','discoverable','consentVersion','createdAt','updatedAt'])
   && d.keys().hasOnly(['displayName','area','languages','philosophies','interests','about','photo','contribution','availability','discoverable','consentVersion','createdAt','updatedAt'])
   && text(d.displayName,80) && d.displayName.size()>0
   && d.area in ['samui-undecided','samui-north','samui-east','samui-south','samui-west','elsewhere','prefer-not-to-say']
   && text(d.languages,120) && text(d.about,600)
   && d.philosophies is list && d.philosophies.size()>0 && d.philosophies.size()<=10
   && d.philosophies.hasOnly(['montessori','waldorf','reggio','charlotte_mason','classical','unschooling','nature-based','project-based','eclectic','exploring'])
   && d.philosophies.toSet().size()==d.philosophies.size()
   && d.interests is list && d.interests.size()<=10 && d.interests.hasOnly(['nature','art','music','science','books','languages','movement','practical','community','travel'])
   && d.interests.toSet().size()==d.interests.size()
   && text(d.photo,180000) && (d.photo=='' || d.photo.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$'))
   && d.contribution in ['exploring','share-teaching','host','specialist','organise']
   && d.availability in ['exploring','weekdays','weekends','flexible']
   && d.discoverable is bool && d.consentVersion=='family-profile-2026-10-17'
   && d.createdAt is timestamp && d.updatedAt==request.time;
  }
  function paired(uid,d){return d.discoverable
   ? getAfter(/databases/$(database)/documents/family_directory/$(uid)).data == card(d)
   : !existsAfter(/databases/$(database)/documents/family_directory/$(uid));}
  function directoryMatches(uid,d){let p=getAfter(/databases/$(database)/documents/adult_profiles/$(uid)).data;return p.discoverable==true && d==card(p);}
  match /adult_profiles/{uid}{
   allow get: if owner(uid) || familyMember(uid);
   allow list: if false;
   allow create: if owner(uid) && valid(request.resource.data) && request.resource.data.createdAt==request.time && paired(uid,request.resource.data);
   allow update: if owner(uid) && valid(request.resource.data) && request.resource.data.createdAt==resource.data.createdAt && paired(uid,request.resource.data);
   allow delete: if owner(uid) && !existsAfter(/databases/$(database)/documents/family_directory/$(uid)) && !existsAfter(/databases/$(database)/documents/family_links/$(uid));
  }
  match /family_directory/{uid}{
   allow get: if request.auth != null;
   allow list: if request.auth != null && request.query.limit != null && request.query.limit<=50;
   allow create,update: if owner(uid) && directoryMatches(uid,request.resource.data);
   allow delete: if owner(uid);
  }
  // Private adult contributions. One deterministic document per owner and kind.
  // Required fields: ownerId (immutable UID <=128), kind (immutable enum),
  // name (1..80), email (3..254), description (10..1600), availability (2..240),
  // adultConfirmed=true, consentVersion, createdAt (immutable timestamp),
  // updatedAt (server time), revision (positive int), status (enum),
  // reviewMessage (0..1000, shared with contributor), reviewerId (0..128).
  // Opt-in member card: no email, exact address, private description or review notes.
  // shareWithMembers bool; listingName <=80; listingSummary 10..400; area enum;
  // interests <=120 and listingAvailability 2..120. Empty strings when not sharing.
  // contribution_directory fields exactly match contributionCard below, paired atomically.
  function contributionReviewer(){return request.auth != null && request.auth.token.email_verified == true && request.auth.token.get('contributionsReviewer',false) == true;}
  function contributionWriter(){return request.auth != null && request.auth.token.email_verified == true && request.auth.token.firebase.sign_in_provider != 'anonymous';}
  function validContribution(d,id){return d.keys().hasAll(['ownerId','kind','name','email','description','availability','adultConfirmed','consentVersion','createdAt','updatedAt','revision','status','reviewMessage','reviewerId','shareWithMembers','listingName','listingSummary','area','interests','listingAvailability'])
   && d.keys().hasOnly(['ownerId','kind','name','email','description','availability','adultConfirmed','consentVersion','createdAt','updatedAt','revision','status','reviewMessage','reviewerId','shareWithMembers','listingName','listingSummary','area','interests','listingAvailability'])
   && text(d.ownerId,128) && d.ownerId.size()>0 && d.kind in ['teaching','hosting','helping'] && id==d.ownerId+'__'+d.kind
   && text(d.name,80) && d.name.matches('.*[^\\s].*')
   && text(d.email,254) && d.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
   && text(d.description,1600) && d.description.size()>=10 && d.description.matches('(?s).*[^\\s].*')
   && text(d.availability,240) && d.availability.size()>=2 && d.availability.matches('.*[^\\s].*')
   && d.adultConfirmed == true && d.consentVersion=='contributions-2026-10-18'
   && d.createdAt is timestamp && d.updatedAt==request.time
   && d.revision is int && d.revision>=1 && d.revision<=1000000
   && d.status in ['submitted','under-review','needs-info','accepted','closed','withdrawn']
   && text(d.reviewMessage,1000) && text(d.reviewerId,128) && validSharing(d);}
  function validSharing(d){return d.shareWithMembers is bool && text(d.listingName,80) && text(d.listingSummary,400) && text(d.area,30) && text(d.interests,120) && text(d.listingAvailability,120)
    && (d.shareWithMembers ? (d.listingName.matches('.*[^\\s].*') && d.listingSummary.size()>=10 && d.listingSummary.matches('(?s).*[^\\s].*') && d.area in ['samui-undecided','samui-north','samui-east','samui-south','samui-west','elsewhere'] && d.listingAvailability.size()>=2 && d.listingAvailability.matches('.*[^\\s].*'))
       : (d.listingName=='' && d.listingSummary=='' && d.area=='' && d.interests=='' && d.listingAvailability==''));}
  function contributionCard(d){return {'ownerId':d.ownerId,'kind':d.kind,'displayName':d.listingName,'summary':d.listingSummary,'area':d.area,'interests':d.interests,'availability':d.listingAvailability,'revision':d.revision,'updatedAt':d.updatedAt};}
  function contributionPaired(id,d){return d.status=='accepted' && d.shareWithMembers
    ? getAfter(/databases/$(database)/documents/contribution_directory/$(id)).data==contributionCard(d)
    : !existsAfter(/databases/$(database)/documents/contribution_directory/$(id));}
  function directoryAuthority(id){return request.auth!=null && (id in [request.auth.uid+'__teaching',request.auth.uid+'__hosting',request.auth.uid+'__helping'] || contributionReviewer());}
  function memberReader(){return request.auth!=null && request.auth.token.firebase.sign_in_provider!='anonymous';}
  function contributionCreate(id){let d=request.resource.data;return contributionWriter() && d.ownerId==request.auth.uid && validContribution(d,id) && contributionPaired(id,d) && d.email==request.auth.token.email && d.createdAt==request.time && d.revision==1 && d.status=='submitted' && d.reviewMessage=='' && d.reviewerId=='';}
  function contributionUpdate(id){let before=resource.data;let after=request.resource.data;return validContribution(after,id) && contributionPaired(id,after)
   && after.ownerId==before.ownerId && after.kind==before.kind && after.createdAt==before.createdAt && after.revision==before.revision+1
   && (
    (owner(before.ownerId) && contributionWriter() && after.status=='submitted' && after.email==request.auth.token.email && after.reviewMessage=='' && after.reviewerId=='')
    || (owner(before.ownerId) && before.status!='withdrawn' && after.status=='withdrawn' && after.diff(before).affectedKeys().hasOnly(['status','updatedAt','revision']))
    || (contributionReviewer() && request.auth.uid!=before.ownerId && before.status!='withdrawn'
      && after.status in ['under-review','needs-info','accepted','closed'] && after.reviewerId==request.auth.uid
      && (after.status=='under-review' || after.reviewMessage.size()>=10)
      && after.diff(before).affectedKeys().hasOnly(['status','reviewMessage','reviewerId','updatedAt','revision']))
   );}
  match /contributions/{id}{
   allow get: if owner(resource.data.ownerId) || contributionReviewer()
     || (request.auth!=null && id in [request.auth.uid+'__teaching',request.auth.uid+'__hosting',request.auth.uid+'__helping'] && !exists(/databases/$(database)/documents/contributions/$(id)));
   allow list: if request.auth!=null && request.query.limit!=null && ((owner(resource.data.ownerId) && request.query.limit<=3) || (contributionReviewer() && request.query.limit<=25));
   allow create: if contributionCreate(id);
   allow update: if contributionUpdate(id);
   allow delete: if owner(resource.data.ownerId) && !existsAfter(/databases/$(database)/documents/contribution_directory/$(id));
  }

  match /contribution_directory/{id}{
   allow get: if memberReader();
   allow list: if memberReader() && request.query.limit!=null && request.query.limit<=24;
   allow create,update: if directoryAuthority(id)
    && getAfter(/databases/$(database)/documents/contributions/$(id)).data.status=='accepted'
    && getAfter(/databases/$(database)/documents/contributions/$(id)).data.shareWithMembers==true
    && getAfter(/databases/$(database)/documents/contributions/$(id)).data.updatedAt==request.time
    && request.resource.data==contributionCard(getAfter(/databases/$(database)/documents/contributions/$(id)).data);
   allow delete: if directoryAuthority(id) && (!existsAfter(/databases/$(database)/documents/contributions/$(id))
    || getAfter(/databases/$(database)/documents/contributions/$(id)).data.status!='accepted'
    || getAfter(/databases/$(database)/documents/contributions/$(id)).data.shareWithMembers==false);
  }

  // Adult introductions are shared only by sender and named recipient.
  // Canonical path encodes both adults; at most one retained request per direction/pair.
  // Required fields: senderId/recipientId immutable UID <=128, targetType family|contribution,
  // targetId <=270, targetName/senderName 1..80, message 10..800, response 0..500,
  // adultConfirmed true, consentVersion, immutable createdAt, updatedAt request time,
  // revision positive integer<=1m, status enum. No account email or child record copied.
  function introAdult(){return request.auth!=null && request.auth.token.firebase.sign_in_provider!='anonymous';}
  function introVerified(){return introAdult() && request.auth.token.email_verified==true;}
  function introParticipant(d){return introAdult() && (owner(d.senderId) || owner(d.recipientId));}
  function introValid(d,sender,recipient){return d.keys().hasAll(['senderId','recipientId','targetType','targetId','targetName','senderName','message','response','adultConfirmed','consentVersion','createdAt','updatedAt','revision','status'])
   && d.keys().hasOnly(['senderId','recipientId','targetType','targetId','targetName','senderName','message','response','adultConfirmed','consentVersion','createdAt','updatedAt','revision','status'])
   && text(d.senderId,128) && d.senderId==sender && text(d.recipientId,128) && d.recipientId==recipient && sender!=recipient
   && d.targetType in ['family','contribution'] && text(d.targetId,270) && d.targetId.size()>0 && !d.targetId.matches('.*[/].*')
   && text(d.targetName,80) && d.targetName.matches('.*[^\\s].*') && text(d.senderName,80) && d.senderName.matches('.*[^\\s].*')
   && text(d.message,800) && d.message.size()>=10 && d.message.matches('(?s).*[^\\s].*') && text(d.response,500)
   && d.adultConfirmed==true && d.consentVersion=='introductions-2026-10-19'
   && d.createdAt is timestamp && d.updatedAt==request.time && d.revision is int && d.revision>=1 && d.revision<=1000000
   && d.status in ['pending','accepted','declined','withdrawn','closed'];}
  function introTarget(d){return d.targetType=='family'
    ? (d.targetId==d.recipientId && exists(/databases/$(database)/documents/family_directory/$(d.targetId)) && get(/databases/$(database)/documents/family_directory/$(d.targetId)).data.displayName==d.targetName)
    : (exists(/databases/$(database)/documents/contribution_directory/$(d.targetId)) && get(/databases/$(database)/documents/contribution_directory/$(d.targetId)).data.ownerId==d.recipientId && get(/databases/$(database)/documents/contribution_directory/$(d.targetId)).data.displayName==d.targetName);}
  function introUpdate(sender,recipient){let before=resource.data;let after=request.resource.data;return introAdult() && introValid(after,sender,recipient)
   && after.createdAt==before.createdAt && after.revision==before.revision+1
   && ((owner(sender) && before.status in ['pending','accepted'] && after.status=='withdrawn' && after.diff(before).affectedKeys().hasOnly(['status','updatedAt','revision']))
    || (introVerified() && owner(recipient) && ((before.status=='pending' && after.status in ['accepted','declined']) || (before.status=='accepted' && after.status in ['accepted','closed']))
       && (after.status!='accepted' || (after.response.size()>=10 && after.response.matches('(?s).*[^\\s].*')))
       && after.diff(before).affectedKeys().hasOnly(['status','response','updatedAt','revision'])));}
  match /introduction_requests/{sender}/introduction_threads/{recipient}{
   allow get: if introAdult() && request.auth.uid in [sender,recipient];
   allow create: if introVerified() && owner(sender) && introValid(request.resource.data,sender,recipient)
    && request.resource.data.createdAt==request.time && request.resource.data.revision==1 && request.resource.data.status=='pending' && request.resource.data.response==''
    && introTarget(request.resource.data) && !exists(/databases/$(database)/documents/introduction_blocks/$(recipient)/blocked/$(sender));
   allow update: if introUpdate(sender,recipient);
   allow delete: if introAdult() && request.auth.uid in [sender,recipient];
  }
  // Collection-group inbox queries must prove participant identity and use pagination.
  match /{path=**}/introduction_threads/{recipient}{allow list: if introParticipant(resource.data) && request.query.limit!=null && request.query.limit<=20;}
  // Private recipient-owned block list. Blocking stops new requests; history remains.
  match /introduction_blocks/{ownerId}/blocked/{senderId}{
   allow get: if introAdult() && owner(ownerId);
   allow list: if introAdult() && owner(ownerId) && request.query.limit!=null && request.query.limit<=25;
   allow create: if introVerified() && owner(ownerId) && ownerId!=senderId && text(senderId,128) && senderId.size()>0
    && request.resource.data.keys().hasAll(['ownerId','blockedId','label','createdAt']) && request.resource.data.keys().hasOnly(['ownerId','blockedId','label','createdAt'])
    && request.resource.data.ownerId==ownerId && request.resource.data.blockedId==senderId && text(request.resource.data.label,80) && request.resource.data.label.matches('.*[^\\s].*') && request.resource.data.createdAt==request.time;
   allow delete: if introAdult() && owner(ownerId);
  }

  // Caregiver-attended, free Events. No pod, learner, payment or guardian records.
  // events/{id}: bounded member listing; immutable host/time/area/title; capacity
  // counts approved GUEST people only. A caregiver's adult account manages one
  // household request; shared-family membership is not inferred.
  // event_locations/{id}: exact address/directions, never included in listings
  // or RSVP documents. Only host and currently approved attendees may get it.
  // events/{id}/event_rsvps/{uid}: household label, counts, consent, saved status
  // and bounded host reply; readable only by requester and that event's host.
  // Every RSVP create/update pairs with a checked event counter transaction.
  // event_mutations/{id}: private write-proof (eventId/hostId/requesterId,
  // rsvpRevision/eventRevision/updatedAt); no client read access. This keeps
  // even internal requester IDs out of member-visible event summaries.
  function eventAdult(){return request.auth!=null && request.auth.token.firebase.sign_in_provider!='anonymous';}
  function eventVerified(){return eventAdult() && request.auth.token.email_verified==true;}
  function eventPublisher(){return eventVerified();}
  function eventText(v,min,max){return text(v,max) && v.size()>=min && (min==0 || v.matches('(?s).*[^\\s].*'));}
  function eventUid(v){return eventText(v,1,128) && !v.matches('.*[/].*');}
  function eventId(id){return id.matches('^[A-Za-z0-9_-]{8,64}$');}
  function eventValid(d){return d.keys().hasAll(['hostId','hostName','title','description','bring','area','kind','venueType','startsAt','endsAt','timeZone','capacity','approvedPeople','status','caregiverRequired','paymentMode','hostConfirmed','consentVersion','revision','createdAt','updatedAt'])
   && d.keys().hasOnly(['hostId','hostName','title','description','bring','area','kind','venueType','startsAt','endsAt','timeZone','capacity','approvedPeople','status','caregiverRequired','paymentMode','hostConfirmed','consentVersion','revision','createdAt','updatedAt'])
   && eventUid(d.hostId) && eventText(d.hostName,1,80) && eventText(d.title,3,100) && eventText(d.description,10,1000) && eventText(d.bring,0,400)
   && d.area in ['north','east','south','west','central'] && d.kind in ['social','learning'] && d.venueType in ['outdoors','home','venue']
   && d.startsAt is timestamp && d.endsAt is timestamp && d.endsAt>d.startsAt && d.endsAt<=d.startsAt+duration.value(24,'h') && d.timeZone=='Asia/Bangkok'
   && d.capacity is int && d.capacity>=1 && d.capacity<=60 && d.approvedPeople is int && d.approvedPeople>=0 && d.approvedPeople<=d.capacity
   && d.status in ['open','cancelled'] && d.caregiverRequired==true && d.paymentMode=='free' && d.hostConfirmed==true && d.consentVersion=='events-caregiver-2026-10-19'
   && d.revision is int && d.revision>=1 && d.revision<=1000000
   && d.createdAt is timestamp && d.updatedAt==request.time;
  }
  function eventLocationValid(d,id){return d.keys().hasAll(['eventId','hostId','address','directions','createdAt','updatedAt']) && d.keys().hasOnly(['eventId','hostId','address','directions','createdAt','updatedAt'])
   && d.eventId==id && eventUid(d.hostId) && eventText(d.address,5,700) && eventText(d.directions,0,700) && d.createdAt==request.time && d.updatedAt==request.time;}
  function eventPlaces(d){return d.status=='approved' ? d.adults+d.children : 0;}
  function eventRsvpValid(d,id,uid){return d.keys().hasAll(['eventId','hostId','requesterId','eventTitle','eventStartsAt','eventArea','householdName','adults','children','caregiverConfirmed','status','hostMessage','consentVersion','createdAt','updatedAt','revision'])
   && d.keys().hasOnly(['eventId','hostId','requesterId','eventTitle','eventStartsAt','eventArea','householdName','adults','children','caregiverConfirmed','status','hostMessage','consentVersion','createdAt','updatedAt','revision'])
   && d.eventId==id && d.requesterId==uid && eventUid(d.requesterId) && eventUid(d.hostId) && d.hostId!=uid
   && eventText(d.eventTitle,3,100) && d.eventStartsAt is timestamp && d.eventArea in ['north','east','south','west','central']
   && eventText(d.householdName,1,80) && d.adults is int && d.adults>=1 && d.adults<=6 && d.children is int && d.children>=0 && d.adults+d.children<=12
   && d.caregiverConfirmed==true && d.consentVersion=='events-caregiver-2026-10-19' && d.status in ['pending','approved','declined','withdrawn'] && eventText(d.hostMessage,0,300)
   && d.createdAt is timestamp && d.updatedAt==request.time && d.revision is int && d.revision>=1 && d.revision<=1000000;}
  function eventBeforeRsvp(id,uid){return exists(/databases/$(database)/documents/events/$(id)/event_rsvps/$(uid)) ? get(/databases/$(database)/documents/events/$(id)/event_rsvps/$(uid)).data : {'status':'none','adults':0,'children':0,'revision':0};}
  function eventCounter(id){let b=resource.data;let a=request.resource.data;let mutation=getAfter(/databases/$(database)/documents/event_mutations/$(id)).data;let uid=mutation.requesterId;let r=eventBeforeRsvp(id,uid);let next=getAfter(/databases/$(database)/documents/events/$(id)/event_rsvps/$(uid)).data;return eventAdult() && b.status=='open' && a.status=='open' && eventUid(uid)
   && (request.auth.uid==uid || request.auth.uid==b.hostId)
   && a.diff(b).affectedKeys().hasOnly(['approvedPeople','revision','updatedAt'])
   && next.eventId==id && next.requesterId==uid && next.hostId==b.hostId && next.revision==r.revision+1 && next.updatedAt==request.time
   && mutation.eventId==id && mutation.hostId==b.hostId && mutation.rsvpRevision==next.revision && mutation.eventRevision==a.revision && mutation.updatedAt==request.time && a.approvedPeople==b.approvedPeople-eventPlaces(r)+eventPlaces(next);}
  function eventRsvpPaired(id,uid,before,next){let e=get(/databases/$(database)/documents/events/$(id)).data;let after=getAfter(/databases/$(database)/documents/events/$(id)).data;let mutation=getAfter(/databases/$(database)/documents/event_mutations/$(id)).data;return e.status=='open' && after.status=='open' && after.revision==e.revision+1 && after.updatedAt==request.time
   && mutation.requesterId==uid && mutation.rsvpRevision==next.revision && mutation.eventRevision==after.revision && mutation.updatedAt==request.time && after.approvedPeople==e.approvedPeople-eventPlaces(before)+eventPlaces(next);}
  function eventMutationWrite(id){let d=request.resource.data;let e=get(/databases/$(database)/documents/events/$(id)).data;let after=getAfter(/databases/$(database)/documents/events/$(id)).data;let before=eventBeforeRsvp(id,d.requesterId);let next=getAfter(/databases/$(database)/documents/events/$(id)/event_rsvps/$(d.requesterId)).data;return eventAdult()
   && d.keys().hasAll(['eventId','hostId','requesterId','rsvpRevision','eventRevision','updatedAt']) && d.keys().hasOnly(['eventId','hostId','requesterId','rsvpRevision','eventRevision','updatedAt'])
   && d.eventId==id && eventUid(d.hostId) && eventUid(d.requesterId) && d.hostId==e.hostId && request.auth.uid in [d.requesterId,e.hostId]
   && d.rsvpRevision is int && d.rsvpRevision>=1 && d.rsvpRevision<=1000000 && d.eventRevision is int && d.eventRevision>=2 && d.eventRevision<=1000000 && d.updatedAt==request.time
   && e.status=='open' && after.status=='open' && after.revision==e.revision+1 && d.eventRevision==after.revision && next.revision==before.revision+1 && d.rsvpRevision==next.revision && next.updatedAt==request.time;}
  function eventRsvpContext(d,id){let e=get(/databases/$(database)/documents/events/$(id)).data;return d.hostId==e.hostId && d.eventTitle==e.title && d.eventStartsAt==e.startsAt && d.eventArea==e.area;}
  function eventRsvpUpdate(id,uid){let b=resource.data;let a=request.resource.data;let e=get(/databases/$(database)/documents/events/$(id)).data;return eventAdult() && eventRsvpValid(a,id,uid) && eventRsvpContext(a,id) && eventRsvpPaired(id,uid,b,a)
   && a.hostId==b.hostId && a.requesterId==b.requesterId && a.createdAt==b.createdAt && a.revision==b.revision+1 && a.eventTitle==b.eventTitle && a.eventStartsAt==b.eventStartsAt && a.eventArea==b.eventArea
   && ((request.auth.uid==uid && eventVerified() && e.startsAt>request.time && a.adults+a.children<=e.capacity && a.status=='pending' && a.hostMessage=='' && a.diff(b).affectedKeys().hasOnly(['householdName','adults','children','status','hostMessage','updatedAt','revision']))
    || (request.auth.uid==uid && b.status in ['pending','approved'] && a.status=='withdrawn' && a.diff(b).affectedKeys().hasOnly(['status','updatedAt','revision']))
    || (eventVerified() && request.auth.uid==e.hostId && ((b.status=='pending' && a.status in ['approved','declined']) || (b.status=='approved' && a.status=='declined'))
      && (a.status!='approved' || e.startsAt>request.time) && a.diff(b).affectedKeys().hasOnly(['status','hostMessage','updatedAt','revision'])));}
  match /events/{id}{
   allow get: if eventAdult();
   allow list: if eventAdult() && request.query.limit!=null && request.query.limit<=20 && (resource.data.status=='open' || resource.data.hostId==request.auth.uid);
   allow create: if eventId(id) && !exists(/databases/$(database)/documents/event_retired_ids/$(id)) && eventPublisher() && eventValid(request.resource.data) && request.resource.data.hostId==request.auth.uid && request.resource.data.createdAt==request.time
    && request.resource.data.startsAt>request.time && request.resource.data.startsAt<request.time+duration.value(366,'d') && request.resource.data.revision==1 && request.resource.data.status=='open' && request.resource.data.approvedPeople==0
    && getAfter(/databases/$(database)/documents/event_locations/$(id)).data.hostId==request.auth.uid && getAfter(/databases/$(database)/documents/event_locations/$(id)).data.createdAt==request.time;
   allow update: if eventAdult() && eventValid(request.resource.data) && request.resource.data.hostId==resource.data.hostId && request.resource.data.createdAt==resource.data.createdAt && request.resource.data.revision==resource.data.revision+1
    && ((owner(resource.data.hostId) && eventVerified() && resource.data.status=='open' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['description','bring','capacity','updatedAt','revision']))
     || (owner(resource.data.hostId) && resource.data.status=='open' && request.resource.data.status=='cancelled' && request.resource.data.approvedPeople==0 && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','approvedPeople','updatedAt','revision']) && !existsAfter(/databases/$(database)/documents/event_locations/$(id)) && !existsAfter(/databases/$(database)/documents/event_mutations/$(id)))
     || eventCounter(id));
   allow delete: if eventAdult() && owner(resource.data.hostId) && resource.data.status=='cancelled' && !existsAfter(/databases/$(database)/documents/event_locations/$(id)) && !existsAfter(/databases/$(database)/documents/event_mutations/$(id)) && getAfter(/databases/$(database)/documents/event_retired_ids/$(id)).data.retiredAt==request.time;
   match /event_rsvps/{uid}{
    allow get: if eventAdult() && (request.auth.uid==uid || owner(get(/databases/$(database)/documents/events/$(id)).data.hostId));
    allow list: if eventAdult() && owner(get(/databases/$(database)/documents/events/$(id)).data.hostId) && request.query.limit!=null && request.query.limit<=25;
    allow create: if eventVerified() && owner(uid) && eventRsvpValid(request.resource.data,id,uid) && eventRsvpContext(request.resource.data,id)
     && get(/databases/$(database)/documents/events/$(id)).data.startsAt>request.time && request.resource.data.adults+request.resource.data.children<=get(/databases/$(database)/documents/events/$(id)).data.capacity && request.resource.data.createdAt==request.time && request.resource.data.revision==1 && request.resource.data.status=='pending' && request.resource.data.hostMessage==''
     && eventRsvpPaired(id,uid,{'status':'none','adults':0,'children':0},request.resource.data);
    allow update: if eventRsvpUpdate(id,uid);
    allow delete: if eventAdult() && owner(uid) && (resource.data.status in ['declined','withdrawn'] || !exists(/databases/$(database)/documents/events/$(id)) || get(/databases/$(database)/documents/events/$(id)).data.status=='cancelled' || get(/databases/$(database)/documents/events/$(id)).data.endsAt<=request.time);
   }
  }
  match /{path=**}/event_rsvps/{uid}{allow list: if eventAdult() && resource.data.requesterId==request.auth.uid && request.query.limit!=null && request.query.limit<=20;}
  match /event_mutations/{id}{
   allow create,update: if eventMutationWrite(id);
   allow read: if false;
   allow delete: if eventAdult() && owner(get(/databases/$(database)/documents/events/$(id)).data.hostId) && (!existsAfter(/databases/$(database)/documents/events/$(id)) || getAfter(/databases/$(database)/documents/events/$(id)).data.status=='cancelled');
  }
  match /event_locations/{id}{
   allow get: if eventAdult() && (owner(get(/databases/$(database)/documents/events/$(id)).data.hostId)
    || (get(/databases/$(database)/documents/events/$(id)).data.status=='open' && get(/databases/$(database)/documents/events/$(id)).data.endsAt>request.time && get(/databases/$(database)/documents/events/$(id)/event_rsvps/$(request.auth.uid)).data.status=='approved'));
   allow list: if false;
   allow create: if eventPublisher() && eventId(id) && eventLocationValid(request.resource.data,id) && request.resource.data.hostId==request.auth.uid && getAfter(/databases/$(database)/documents/events/$(id)).data.hostId==request.auth.uid && getAfter(/databases/$(database)/documents/events/$(id)).data.createdAt==request.time;
   allow update: if false;
   allow delete: if eventAdult() && owner(resource.data.hostId) && (!existsAfter(/databases/$(database)/documents/events/$(id)) || getAfter(/databases/$(database)/documents/events/$(id)).data.status=='cancelled');
  }
  // Retirement prevents a deleted event ID from being reused around old RSVPs.
  // This marker contains only a server timestamp, no adult identity or location.
  match /event_retired_ids/{id}{
   allow create: if eventAdult() && eventId(id) && owner(get(/databases/$(database)/documents/events/$(id)).data.hostId) && get(/databases/$(database)/documents/events/$(id)).data.status=='cancelled' && !existsAfter(/databases/$(database)/documents/events/$(id))
    && request.resource.data.keys().hasAll(['retiredAt']) && request.resource.data.keys().hasOnly(['retiredAt']) && request.resource.data.retiredAt==request.time;
   allow read,update,delete: if false;
  }

  // Adult family access pilot. No learner/guardian or cross-adult message rights.
  // family_links/{owner}: immutable ownerId, members(unique UID list <=6),
  // names/consents maps keyed exactly by members, inviteIds(unique SHA256 list<=5),
  // lastInviteId/lastMemberId mutation witnesses, revision, consentVersion,
  // immutable createdAt and updatedAt=request.time. Only first parent manages.
  // invites/{sha256}: ownerId, recipientEmail, familyName/inviterName, status,
  // createdAt/updatedAt/expiresAt and consentVersion. Token never stored.
  // Acceptance consumes the invite and atomically records membership/consent.
  function familyActor(){return request.auth!=null && request.auth.token.firebase.sign_in_provider!='anonymous';}
  function familyVerified(){return familyActor() && request.auth.token.email_verified==true;}
  function familyName(v){return text(v,80) && v.matches('.*[^\\s].*') && !v.matches('(?s).*[\\x00-\\x1F\\x7F].*');}
  function familyRecipient(d){return familyVerified() && request.auth.token.get('email','') is string && request.auth.token.get('email','').lower()==d.recipientEmail;}
  function familyMember(id){return familyActor() && exists(/databases/$(database)/documents/family_links/$(id)) && request.auth.uid in get(/databases/$(database)/documents/family_links/$(id)).data.members;}
  function validFamilyLink(d,id){return d.keys().hasAll(['ownerId','members','names','consents','inviteIds','lastInviteId','lastMemberId','revision','consentVersion','createdAt','updatedAt'])
   && d.keys().hasOnly(['ownerId','members','names','consents','inviteIds','lastInviteId','lastMemberId','revision','consentVersion','createdAt','updatedAt'])
   && d.ownerId==id && d.members is list && d.members.size()>=1 && d.members.size()<=6 && d.members.toSet().size()==d.members.size() && id in d.members
   && d.names is map && d.names.keys().hasAll(d.members) && d.names.keys().hasOnly(d.members)
   && d.consents is map && d.consents.keys().hasAll(d.members) && d.consents.keys().hasOnly(d.members) && d.consents.values().hasOnly(['family-membership-2026-10-28'])
   && d.inviteIds is list && d.inviteIds.size()<=5 && d.inviteIds.toSet().size()==d.inviteIds.size()
   && d.lastInviteId is string && d.lastInviteId.matches('^[a-f0-9]{64}$') && text(d.lastMemberId,128)
   && d.revision is int && d.revision>=1 && d.revision<=1000000 && d.consentVersion=='family-membership-2026-10-28'
   && d.createdAt is timestamp && d.updatedAt==request.time;
  }
  function validFamilyInvite(d,id){return d.keys().hasAll(['ownerId','recipientEmail','familyName','inviterName','status','createdAt','updatedAt','expiresAt','consentVersion'])
   && d.keys().hasOnly(['ownerId','recipientEmail','familyName','inviterName','status','createdAt','updatedAt','expiresAt','consentVersion'])
   && d.ownerId==id && text(d.recipientEmail,254) && d.recipientEmail.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$') && d.recipientEmail==d.recipientEmail.lower()
   && familyName(d.familyName) && familyName(d.inviterName) && d.status in ['pending','revoked']
   && d.createdAt is timestamp && d.updatedAt==request.time && d.expiresAt is timestamp && d.expiresAt>d.createdAt && d.expiresAt<=d.createdAt+duration.value(48,'h')
   && d.consentVersion=='family-membership-2026-10-28';
  }
  function familyLinkCreate(id){let d=request.resource.data;let i=getAfter(/databases/$(database)/documents/family_links/$(id)/invites/$(d.lastInviteId)).data;
   return familyVerified() && owner(id) && validFamilyLink(d,id) && d.members==[id] && familyName(d.names[id]) && d.inviteIds==[d.lastInviteId]
    && d.lastMemberId=='' && d.revision==1 && d.createdAt==request.time && i.ownerId==id && i.status=='pending' && i.createdAt==request.time
    && existsAfter(/databases/$(database)/documents/adult_profiles/$(id));
  }
  function familyAddInvite(id,b,d){return familyVerified() && owner(id)
   && d.diff(b).affectedKeys().hasOnly(['inviteIds','lastInviteId','revision','updatedAt'])
   && d.inviteIds.size()==b.inviteIds.size()+1 && d.inviteIds.hasAll(b.inviteIds) && d.lastInviteId in d.inviteIds && !(d.lastInviteId in b.inviteIds)
   && !exists(/databases/$(database)/documents/family_links/$(id)/invites/$(d.lastInviteId))
   && getAfter(/databases/$(database)/documents/family_links/$(id)/invites/$(d.lastInviteId)).data.createdAt==request.time;
  }
  function familyAccept(id,b,d){let uid=request.auth.uid;let path=/databases/$(database)/documents/family_links/$(id)/invites/$(d.lastInviteId);let i=get(path).data;
   return familyVerified() && uid!=id && !(uid in b.members) && d.members.hasAll(b.members) && d.members.size()==b.members.size()+1 && uid in d.members
    && d.diff(b).affectedKeys().hasOnly(['members','names','consents','inviteIds','lastInviteId','revision','updatedAt'])
    && d.names.diff(b.names).affectedKeys().hasOnly([uid]) && familyName(d.names[uid]) && d.consents.diff(b.consents).affectedKeys().hasOnly([uid])
    && d.lastInviteId in b.inviteIds && !(d.lastInviteId in d.inviteIds) && b.inviteIds.hasAll(d.inviteIds) && d.inviteIds.size()==b.inviteIds.size()-1
    && i.ownerId==id && i.status=='pending' && i.expiresAt>request.time && familyRecipient(i) && !existsAfter(path);
  }
  function familyRemove(id,b,d){let uid=d.lastMemberId;return familyActor() && uid!=id && uid in b.members && !(uid in d.members) && b.members.hasAll(d.members) && d.members.size()==b.members.size()-1
   && (owner(id)||request.auth.uid==uid) && d.names.diff(b.names).affectedKeys().hasOnly([uid]) && d.consents.diff(b.consents).affectedKeys().hasOnly([uid])
   && d.diff(b).affectedKeys().hasOnly(['members','names','consents','lastMemberId','revision','updatedAt']);
  }
  function familyEraseInvite(id,b,d){return familyActor() && owner(id) && d.diff(b).affectedKeys().hasOnly(['inviteIds','lastInviteId','revision','updatedAt'])
   && d.lastInviteId in b.inviteIds && !(d.lastInviteId in d.inviteIds) && b.inviteIds.hasAll(d.inviteIds) && d.inviteIds.size()==b.inviteIds.size()-1
   && !existsAfter(/databases/$(database)/documents/family_links/$(id)/invites/$(d.lastInviteId));}
  function familyLinkUpdate(id){let b=resource.data;let d=request.resource.data;return familyActor() && validFamilyLink(d,id) && d.createdAt==b.createdAt && d.revision==b.revision+1
   && (familyAddInvite(id,b,d)||familyAccept(id,b,d)||familyRemove(id,b,d)||familyEraseInvite(id,b,d));}
  function familyInvitesGone(id,ids){return (ids.size()<1 || !existsAfter(/databases/$(database)/documents/family_links/$(id)/invites/$(ids[0])))
   && (ids.size()<2 || !existsAfter(/databases/$(database)/documents/family_links/$(id)/invites/$(ids[1])))
   && (ids.size()<3 || !existsAfter(/databases/$(database)/documents/family_links/$(id)/invites/$(ids[2])))
   && (ids.size()<4 || !existsAfter(/databases/$(database)/documents/family_links/$(id)/invites/$(ids[3])))
   && (ids.size()<5 || !existsAfter(/databases/$(database)/documents/family_links/$(id)/invites/$(ids[4])));}
  match /family_links/{id}{
   allow get: if familyActor() && (owner(id)||request.auth.uid in resource.data.members);
   allow list: if familyActor() && request.auth.uid in resource.data.members && request.query.limit!=null && request.query.limit<=20;
   allow create: if familyLinkCreate(id);
   allow update: if familyLinkUpdate(id);
   allow delete: if familyActor() && owner(id) && resource.data.members==[id] && familyInvitesGone(id,resource.data.inviteIds);
   match /invites/{inviteId}{
    allow get: if familyActor() && (owner(id)||familyRecipient(resource.data));
    allow list: if familyActor() && owner(id) && request.query.limit!=null && request.query.limit<=5;
    allow create: if familyVerified() && owner(id) && inviteId.matches('^[a-f0-9]{64}$') && validFamilyInvite(request.resource.data,id)
     && request.resource.data.status=='pending' && request.resource.data.createdAt==request.time && request.resource.data.recipientEmail!=request.auth.token.email.lower()
     && request.resource.data.familyName==getAfter(/databases/$(database)/documents/adult_profiles/$(id)).data.displayName
     && inviteId in getAfter(/databases/$(database)/documents/family_links/$(id)).data.inviteIds;
    allow update: if familyActor() && owner(id) && validFamilyInvite(request.resource.data,id) && resource.data.status=='pending' && request.resource.data.status=='revoked'
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']);
    allow delete: if familyActor() && (
     (owner(id) && (!existsAfter(/databases/$(database)/documents/family_links/$(id)) || !(inviteId in getAfter(/databases/$(database)/documents/family_links/$(id)).data.inviteIds)))
     || (familyRecipient(resource.data) && resource.data.status=='pending' && resource.data.expiresAt>request.time
      && request.auth.uid in getAfter(/databases/$(database)/documents/family_links/$(id)).data.members
      && getAfter(/databases/$(database)/documents/family_links/$(id)).data.consents[request.auth.uid]=='family-membership-2026-10-28'
      && !(inviteId in getAfter(/databases/$(database)/documents/family_links/$(id)).data.inviteIds))
    );
   }
  }

  match /{document=**}{allow read,write: if false;}
 }
}
